{
  "name": "slate",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite dev",
    "dev:design": "HF_DESIGN_INSPECTOR=1 vite dev --mode design",
    "build": "tsc --noEmit && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:slate": "eslint src/slate --quiet",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "typecheck:packages": "for dir in packages/*; do if [ -f \"$dir/package.json\" ]; then (cd \"$dir\" && bun run typecheck); fi; done",
    "test:packages": "for dir in packages/*; do if [ -f \"$dir/package.json\" ]; then (cd \"$dir\" && bun run test); fi; done",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "playwright test",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "package:desktop": "node platform/desktop/package.cjs",
    "android:sync": "cap sync android",
    "android:build": "node platform/android/build-apk.mjs",
    "package:linux": "node platform/desktop/package-linux.cjs",
    "test:desktop:linux": "bun tests/desktop/smoke.mjs",
    "android:release": "node platform/android/build-release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "@capacitor/android": "^8.5.2",
